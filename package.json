  },
  "dependencies": {
    "@biomejs/biome": "^2.4.15",
    "@clack/prompts": "^1.4.0",
    "@earendil-works/pi-agent-core": "^0.78.0",
    "@earendil-works/pi-ai": "^0.74.1",
    "better-sqlite3": "^12.10.0",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1"
  }
