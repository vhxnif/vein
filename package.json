{
    "name": "vein",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "cd packages/cli && bun run build",
        "link": "cd packages/cli && bun run build && bun link",
        "unlink": "cd packages/cli && bun unlink",
        "dev:web": "cd packages/web && bun run dev",
        "dev:web:node": "cd packages/web && bun run build:backend && node dist/server.js",
        "build:web": "cd packages/web && bun run build",
        "check": "tsc --noEmit",
        "lint": "bunx --bun @biomejs/biome lint",
        "lint:fix": "bunx --bun @biomejs/biome lint --write .",
        "format": "bunx --bun @biomejs/biome check --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "typescript": "^5"
    }
}
