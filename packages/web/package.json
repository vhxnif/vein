{
    "name": "@vein/web",
    "version": "0.1.0",
    "type": "module",
    "bin": {
        "vein-web": "./dist/server.js"
    },
    "scripts": {
        "dev": "bun run --watch src/server.ts",
        "dev:frontend": "vite",
        "build:frontend": "vite build",
        "build:backend": "bun build src/server.ts --target node --outdir ./dist --sourcemap --minify --external better-sqlite3",
        "build": "bun run build:frontend && bun run build:backend",
        "start": "node dist/server.js",
        "link": "bun link",
        "unlink": "bun unlink",
        "check": "tsc --noEmit"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.71.10",
        "@tanstack/react-router": "^1.115.0",
        "@vein/core": "workspace:*",
        "hono": "^4.7.5",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@types/react": "^19.1.1",
        "@types/react-dom": "^19.1.2",
        "@tailwindcss/vite": "^4.1.5",
        "@tanstack/router-plugin": "^1.115.0",
        "tailwindcss": "^4.1.5",
        "vite": "^6.3.2",
        "@vitejs/plugin-react": "^4.4.1"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}
